# La validación con Zod (fail-fast) se agrega en la Fase 1. Este archivo
# documenta las variables que va a requerir el server.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

MONGODB_URI=mongodb://localhost:27017/amanda

JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MERCADOPAGO_ACCESS_TOKEN=

RESEND_API_KEY=
EMAIL_FROM=Amanda Home & Deco <no-reply@amandahomedeco.com.ar>

# Cotización y carga de envíos vía API MiCorreo (Correo Argentino). Sin
# estas variables se usa un proveedor simulado.
# MICORREO_USER/PASSWORD son credenciales de integración (Basic Auth) que
# Correo Argentino entrega por separado para cada ambiente a través de un
# ejecutivo comercial — NO son el login normal de la web de MiCorreo.
# MICORREO_CUSTOMER_ID se obtiene una sola vez corriendo:
#   MICORREO_ACCOUNT_EMAIL=... MICORREO_ACCOUNT_PASSWORD=... npm run shipping:customer-id -w packages/server
# (ahí sí van el email/contraseña de tu cuenta normal de MiCorreo, solo para esa corrida)
MICORREO_ENV=test
MICORREO_USER=
MICORREO_PASSWORD=
MICORREO_CUSTOMER_ID=
